#!/bin/sh
# noctalia-dt: run Noctalia on the dt-retire Mesa + MaliBridge hook2 chain.
#
# This file is a template. install-mali-stack.sh copies it into the bundle as
# share/xring-o3/noctalia-dt and fills in the stack-current path and the
# noctalia binary path while writing /usr/local/bin/noctalia-dt. Every other
# path comes from conf/noctalia-env.conf, so a stack upgrade rewrites the conf.
#
# niri starts this wrapper with `spawn-at-startup "/usr/local/bin/noctalia-dt"
# "noctalia"`; extra arguments are passed through to the binary.
set -eu

STACK_CURRENT="${NOCTALIA_STACK_CURRENT:-@STACK_CURRENT@}"
CONF="${NOCTALIA_ENV_FILE:-${STACK_CURRENT}/conf/noctalia-env.conf}"
noctalia_bin_override="${NOCTALIA_BIN:-}"

[ -r "$CONF" ] || {
    printf 'noctalia-dt: 缺少环境配置 %s\n' "$CONF" >&2
    exit 1
}
# shellcheck disable=SC1090
. "$CONF"

# An exported NOCTALIA_BIN wins over the generated conf (upgrade and test hook).
NOCTALIA_BIN="${noctalia_bin_override:-${NOCTALIA_BIN:-@NOCTALIA_BIN@}}"

[ -x "$NOCTALIA_BIN" ] || {
    printf 'noctalia-dt: 找不到 noctalia 可执行文件 %s\n' "$NOCTALIA_BIN" >&2
    exit 1
}

# dt-retire Mesa, hook2 MaliBridge client and the wl-surface-gone shim, matching
# the wrapper the device runs. VKBRIDGE_WSI_SHM stays unset: WSI goes through
# dmabuf, same bridge server as the niri/zc-run chain.
export LD_LIBRARY_PATH="$NOCTALIA_MESA_DIR/candidate/usr/lib"
export __EGL_VENDOR_LIBRARY_FILENAMES="$NOCTALIA_EGL_VENDOR_JSON"
export VK_DRIVER_FILES="$NOCTALIA_ICD"
export LD_PRELOAD="$NOCTALIA_LD_PRELOAD"
export VKBRIDGE_SOCKET="$NOCTALIA_BRIDGE_SOCKET"
export VKBRIDGE_LOG_LEVEL="${NOCTALIA_BRIDGE_LOG_LEVEL:-2}"
export VKBRIDGE_WLHOOK_TRACE="${NOCTALIA_VKBRIDGE_WLHOOK_TRACE:-1}"
export MESA_LOADER_DRIVER_OVERRIDE=zink
export GALLIUM_DRIVER=zink
export LIBGL_KOPPER_DISABLE=false
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-$NOCTALIA_XDG_RUNTIME_DIR}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$NOCTALIA_WAYLAND_DISPLAY}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-$NOCTALIA_DBUS_ADDRESS}"
unset VKBRIDGE_WSI_SHM VK_ICD_FILENAMES LIBGL_ALWAYS_SOFTWARE MESA_KOPPER_LIFECYCLE_TRACE

if [ -n "${NOCTALIA_STDERR_LOG:-}" ]; then
    exec "$NOCTALIA_BIN" "$@" 2>>"$NOCTALIA_STDERR_LOG"
fi
exec "$NOCTALIA_BIN" "$@"
