#!/bin/bash
# zc-launch: generic desktop application dispatcher.
#
# Noctalia is configured with:
#   launch_apps_custom_command = "/usr/local/bin/zc-launch $CMD"
# so every app launched from the launcher, dock, or taskbar passes through
# this script.  It classifies the real binary with zc-classify and only wraps
# Chromium/Electron, WebKit and Gecko apps with zc-run; everything else is
# exec'd untouched.
#
# It also handles the Electron path-with-space zygote bug generically: when a
# Chromium-class binary lives under a path containing whitespace, add
# --no-sandbox --no-zygote unless the caller already supplied them.
#
# ZC_LAUNCH_DRY_RUN=1 prints the resolved command instead of executing it.
set -u

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}
log_file=$state_dir/zc-launch.log
mkdir -p "$state_dir" 2>/dev/null || true
log() { printf '%s %s\n' "$(date '+%F %T%z')" "$*" >>"$log_file" 2>/dev/null || true; }

args=("$@")
[ "${#args[@]}" -gt 0 ] || exit 0

passthrough() {
    if [ "${ZC_LAUNCH_DRY_RUN:-0}" = 1 ]; then
        printf '%q ' "${args[@]}"
        printf '\n'
        exit 0
    fi
    exec "${args[@]}"
}

# xring-wrap-desktop (the existing install-time wrapper) produces
#   zc-run --class chromium "/opt/Foo Bar/foo" ...
# which still hits the Electron zygote path-space bug.  When Noctalia passes
# such an entry through zc-launch, add the two flags to the zc-run argv.
# Returns 1 when nothing needs changing so the caller can pass through.
fix_zcrun_pathspace() {
    local -a a=("$@")
    local cls="" cmdpath="" i=1
    while [ "$i" -lt "${#a[@]}" ]; do
        case "${a[$i]}" in
            --class)
                cls=${a[$((i + 1))]:-}
                i=$((i + 2))
                ;;
            --class=*)
                cls=${a[$i]#--class=}
                i=$((i + 1))
                ;;
            --no-shim|--print-env|--verbose)
                i=$((i + 1))
                ;;
            --)
                i=$((i + 1))
                break
                ;;
            -*)
                i=$((i + 1))
                ;;
            *)
                cmdpath=${a[$i]}
                break
                ;;
        esac
    done
    [ -n "$cmdpath" ] || return 1
    if [ -z "$cls" ] && [ -n "${classifier:-}" ] && [ -x "$classifier" ]; then
        cls=$("$classifier" "$cmdpath" 2>/dev/null || true)
    fi
    [ "$cls" = chromium ] || return 1
    case "$cmdpath" in
        *[[:space:]]*) ;;
        *) return 1 ;;
    esac
    local has_ns=0 has_nz=0 x
    for x in "${a[@]}"; do
        [ "$x" = --no-sandbox ] && has_ns=1
        [ "$x" = --no-zygote ] && has_nz=1
    done
    if [ "$has_ns" = 1 ] && [ "$has_nz" = 1 ]; then
        return 1
    fi
    [ "$has_ns" = 1 ] || a+=(--no-sandbox)
    [ "$has_nz" = 1 ] || a+=(--no-zygote)
    if [ "${ZC_LAUNCH_DRY_RUN:-0}" = 1 ]; then
        printf '%q ' "${prefix[@]}" "${a[@]}"
        printf '\n'
        exit 0
    fi
    log "zc-run-pathspace cmd=$cmdpath action=append-flags"
    exec "${prefix[@]}" "${a[@]}"
}

# Skip an optional env(1) prefix so the real command can be classified.
idx=0
if [ "${args[0]}" = "env" ]; then
    idx=1
    while [ "$idx" -lt "${#args[@]}" ]; do
        case "${args[$idx]}" in
            [A-Za-z_]*=*) idx=$((idx + 1)) ;;
            -*) idx=$((idx + 1)) ;;
            *) break ;;
        esac
    done
fi
cmd=${args[$idx]:-}
[ -n "$cmd" ] || exec "${args[@]}"
cmd_args=("${args[@]:$((idx + 1))}")
prefix=("${args[@]:0:$idx}")

resolved=$cmd
if [[ "$cmd" != */* ]]; then
    resolved=$(command -v -- "$cmd" 2>/dev/null || true)
fi
if [ -z "$resolved" ] || [ ! -e "$resolved" ]; then
    log "missing cmd=$cmd action=passthrough"
    passthrough
fi
base=$(basename -- "$resolved")

classifier=${ZC_CLASSIFY:-}
if [ -z "$classifier" ] || [ ! -x "$classifier" ]; then
    classifier=
    for candidate in \
        /opt/mali-stack/current/lib/zc-run/zc-classify \
        /usr/local/lib/zc-run/zc-classify; do
        if [ -x "$candidate" ]; then
            classifier=$candidate
            break
        fi
    done
fi

# Exact wrapper paths must not be wrapped again.  Matching only the basename
# would also skip the real binaries (e.g. "/opt/Kimi Code/kimi-code").
case "$resolved" in
    /usr/local/bin/zc-run|/opt/mali-stack/current/bin/zc-run)
        # Existing xring-wrap-desktop entries can carry a Chromium path with
        # spaces; add the non-zygote flags before passing through.
        fix_zcrun_pathspace "$resolved" "${cmd_args[@]}" || true
        log "handled path=$resolved action=passthrough"
        passthrough
        ;;
    /usr/local/bin/zc-launch|/usr/local/bin/google-chrome|/usr/local/bin/google-chrome-stable|/usr/local/bin/kimi-code|/usr/local/bin/dbx|/usr/local/bin/dbx-dmabuf|/usr/local/bin/zen|/usr/local/bin/zen-browser|/usr/bin/magpie|/usr/local/bin/magpie|/usr/local/bin/noctalia-dt|/usr/local/bin/gpu-app-bridge)
        log "handled path=$resolved action=passthrough"
        passthrough
        ;;
esac

# A script that already invokes zc-run/zc-launch is a wrapper; pass it through.
# Only inspect scripts (shebang), not ELF binaries that may contain the same
# strings in their embedded resources.
if [ -f "$resolved" ] && head -c 2 "$resolved" 2>/dev/null | grep -q '#!' \
    && head -n 40 "$resolved" 2>/dev/null | grep -aqE 'zc-run|zc-launch'; then
    log "wrapper base=$base action=passthrough"
    passthrough
fi

if [ -z "$classifier" ]; then
    log "classifier-missing base=$base action=passthrough"
    passthrough
fi
class=$("$classifier" "$resolved" 2>/dev/null || echo unknown)
case "$class" in
    chromium|webkit|gecko) ;;
    *)
        log "class=$class base=$base action=passthrough"
        passthrough
        ;;
esac

zc_run=/usr/local/bin/zc-run
[ -x "$zc_run" ] || zc_run=/opt/mali-stack/current/bin/zc-run
final=("${prefix[@]}" "$zc_run" --class "$class" "$resolved" "${cmd_args[@]}")
flags=""

has_arg() {
    local needle=$1 arg
    for arg in "${cmd_args[@]}"; do
        [ "$arg" = "$needle" ] && return 0
    done
    return 1
}

# Electron/Chromium zygote splits the executable path on spaces.  Paths such
# as "/opt/Kimi Code/kimi-code" need the non-zygote launch path; Electron
# requires --no-sandbox together with --no-zygote.
case "$resolved" in
    *[[:space:]]*)
        if [ "$class" = chromium ]; then
            if ! has_arg --no-sandbox; then
                final+=(--no-sandbox)
                flags="$flags,no-sandbox"
            fi
            if ! has_arg --no-zygote; then
                final+=(--no-zygote)
                flags="$flags,no-zygote"
            fi
        fi
        ;;
esac

if [ "${ZC_LAUNCH_DRY_RUN:-0}" = 1 ]; then
    printf '%q ' "${final[@]}"
    printf '\n'
    exit 0
fi

log "class=$class base=$base action=zc-run$flags"
exec "${final[@]}"
