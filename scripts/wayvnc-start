#!/bin/bash
# wayvnc-start —— wayvnc 启动包装脚本
# 自动检测 niri 创建的 wayland-N socket 名（niri 可能用 wayland-0 或 wayland-1），
# 并等待 socket 文件出现在文件系统中（防止 socket 被 unlink 后 wayvnc 连不上）。
# 供 wayvnc.service ExecStart 调用。
set -euo pipefail

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
CONFIG="${1:-/etc/wayvnc/config}"

# 最多等待 30 秒，直到检测到 wayland-N socket
for _ in $(seq 1 30); do
    # 查找 wayland-N socket（排除 .lock 文件）
    SOCK="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -name 'wayland-[0-9]*' -type s 2>/dev/null | head -1)"
    if [ -n "$SOCK" ]; then
        WAYLAND_DISPLAY="$(basename "$SOCK")"
        export WAYLAND_DISPLAY
        break
    fi
    sleep 1
done

if [ -z "${WAYLAND_DISPLAY:-}" ]; then
    echo "错误: 30 秒内未在 $XDG_RUNTIME_DIR 检测到 wayland-N socket" >&2
    echo "  请确认 niri.service 已启动且创建了 wayland socket" >&2
    exit 1
fi

echo "wayvnc-start: WAYLAND_DISPLAY=$WAYLAND_DISPLAY, XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
exec /usr/bin/wayvnc --config "$CONFIG"
