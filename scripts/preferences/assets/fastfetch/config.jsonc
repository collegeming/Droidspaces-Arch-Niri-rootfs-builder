{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "padding": {
            "top": 0,
            "left": 1,
            "right": 1
        },
        "color": {
            "1": "blue",
            "2": "magenta"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "magenta"
        },
        "key": {
            "width": 10
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "OS",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "Pkgs",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "Shell",
            "keyColor": "magenta",
            "format": "{result}",
            "text": "ff-shell-stack"
        },
        {
            "type": "display",
            "key": "Display",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": "Term",
            "keyColor": "magenta"
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "yellow",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "yellow",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "Mem",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "Disk",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "Batt",
            "keyColor": "yellow"
        },
        "colors"
    ]
}
