{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        // 使用 fastfetch 自带 Fedora 徽标（38 列 × 19 行），不自建 ASCII
        "type": "builtin",
        "source": "Fedora",
        "padding": {
            "top": 2,
            "left": 2,
            "right": 2
        },
        "color": {
            "1": "blue",
            "2": "magenta"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "magenta"
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "command",
            // 只显示版本 + Android 版本，例如 6.18.21 (Android 17)
            "key": " Kernel",
            "keyColor": "blue",
            "format": "{result}",
            "text": "uname -r | sed -E 's/^([^-]+)-android([0-9]+).*/\\1 (Android \\2)/; t; s/-.*//'"
        },
        {
            "type": "uptime",
            "key": "󱎫 Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "key": "󰆌 Shell",
            "keyColor": "magenta",
            "format": "{result}",
            "text": "ff-shell-stack"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "magenta"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "󰲍 Dev Tools",
            "keyColor": "cyan",
            "format": "{result}",
            "text": "ff-sdks",
            "splitLines": true
        },
        {
            "type": "separator",
            "string": "─"
        },
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "yellow"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "yellow",
            // 这台设备只有 SoC 核显，[Integrated] 没有额外信息量
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "󰁹 Battery",
            "keyColor": "yellow"
        },
        {
            "type": "separator",
            "string": "─"
        },
        "colors"
    ]
}